# Copy to .env and fill in. Loaded via dotenvy at startup.

# --- LLM (required) ---
OPENROUTER_API_KEY=sk-or-...

# Optional model overrides (defaults in src/main.rs)
#CHAT_MODEL=deepseek/deepseek-v4-flash
#MEMORY_MODEL=openai/gpt-oss-20b:nitro

# Optional: web search tool for chat fact-checking; disabled when unset
#TAVILY_API_KEY=tvly-...

# --- Turso Cloud sync (optional; fully local without it) ---
# turso db show kratt --url / turso db tokens create kratt — see README
#TURSO_DATABASE_URL=libsql://kratt-<org>.turso.io
#TURSO_AUTH_TOKEN=...

# --- Telegram gateway (required only for --telegram mode) ---
# Bot token from @BotFather. Use a SEPARATE dev bot for development:
# two pollers on one token fight over getUpdates.
#TELEGRAM_BOT_TOKEN=123456:ABC-...
# Your numeric Telegram user id (message @userinfobot to get it).
# Hard allowlist: updates from anyone else are dropped silently.
#TELEGRAM_USER_ID=123456789
# Nightly dream window (hours in UTC — the app clock, same as log/session
# dates; Estonia summer = UTC+3, so 1-4 means 4-7am local). start-end, end
# exclusive; wrapping ranges like 23-5 work. Inside this window an idle daemon
# runs consolidation (dream/explore) passes; outside it never does.
#KRATT_DREAM_HOURS=1-4

# --- Data root (optional; default kratt-data) ---
# Dev isolation: point dev runs at a throwaway dir so the live graph is
# never touched. DB, graph toon, logs, and sessions all follow this.
# A custom data dir also DISABLES Turso cloud sync (so dev runs cannot
# write into the live cloud database); set KRATT_SYNC=1 to opt back in.
#KRATT_DATA_DIR=kratt-data-dev
#KRATT_SYNC=1
